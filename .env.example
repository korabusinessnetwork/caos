# Caos Diário — variáveis de ambiente (EXEMPLO)
# Copie para .env.local e preencha. NUNCA versione .env / .env.local.
# No front (Vite) só expõe variáveis com prefixo VITE_.

# --- Cliente (seguro expor: chave pública anon) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- NUNCA no front. Só no ambiente das Edge Functions / servidor. ---
# Não prefixe com VITE_ para não vazar no bundle.
# SUPABASE_SERVICE_ROLE_KEY=coloque-apenas-no-servidor

# --- Web Push (VAPID) — gere seu par de chaves ---
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
# VAPID_PRIVATE_KEY=apenas-no-servidor
